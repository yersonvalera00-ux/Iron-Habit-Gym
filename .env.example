# =============================================================
# VARIABLES DE ENTORNO — IRON HABIT GYM
# Copia este archivo como '.env' y reemplaza con tus credenciales reales
# =============================================================

# --- Configuración de Base de Datos MySQL (XAMPP por defecto) ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=iron_habit_database

# --- Configuración de Google OAuth 2.0 ---
# Obtén estas credenciales en https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui

# URL de redirección autorizada registrada en la consola de Google:
# Si usas Apache de XAMPP (carpeta htdocs/iron-habit):
GOOGLE_REDIRECT_URI=http://localhost/iron-habit/google-callback.php
# Si usas el servidor embebido de PHP (php -S localhost:8000), descomenta la siguiente línea:
# GOOGLE_REDIRECT_URI=http://localhost:8000/google-callback.php
